# GlanceTrade backend env — copy to .env, never commit .env
# Port the server listens on (default 3001)
PORT=3001
# STT provider key — Groq (user decision 27 Nov 2026 ~09:05; OpenAI NOT
# used — its key is valid but the account holds $0 credits, so its Whisper
# calls are refused with 429 insufficient_quota).
# Leave empty to run the STT stub (POST /api/stt answers 503
# "not configured" and the app falls back to tap + typed commands).
# The key is read from env or this file at request time — never commit .env.
GROQ_API_KEY=
# Telegram relay (optional, disabled by default). Only used if both are set
# AND the app opts in via POST /api/alerts/telegram with enabled=true.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
